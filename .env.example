# ---------------------------------------------------------------------------
# Letterboxd source
# ---------------------------------------------------------------------------
# Your Letterboxd username. Your watchlist must be publicly visible.
LETTERBOXD_USERNAME=yourusername

# Optional: extra lists, comma separated. Accepts full URLs, "user/list/slug"
# or "user/watchlist".
#LETTERBOXD_LISTS=yourusername/list/best-of-2024,https://letterboxd.com/friend/watchlist/

# ---------------------------------------------------------------------------
# Where the films should go: overseerr | plex | both
# ---------------------------------------------------------------------------
SYNC_TARGET=overseerr

# --- Route A: request directly in Overseerr / Jellyseerr / Seerr -----------
# Settings > General > API Key
OVERSEERR_URL=http://192.168.1.10:5055
OVERSEERR_API_KEY=changeme
# Optional: file the requests under a specific Overseerr user id instead of
# the API key's owner (Settings > Users shows the id in each user's URL).
#OVERSEERR_USER_ID=1
#OVERSEERR_IS_4K=false

# --- Route B: add to the Plex watchlist, let Overseerr pick it up ----------
# https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
#PLEX_TOKEN=changeme
# Remove films from the Plex watchlist when they leave your Letterboxd list.
# Only ever touches films this tool added itself.
#PRUNE_PLEX_WATCHLIST=false

# ---------------------------------------------------------------------------
# Scheduling and behaviour
# ---------------------------------------------------------------------------
# Minutes between syncs. 0 = run once and exit (use this with cron).
SYNC_INTERVAL_MINUTES=360

# Report what would happen without changing anything.
DRY_RUN=false

# Only process the first N films. 0 = no limit. Handy for a first test.
LIMIT=0

# Seconds to wait between Letterboxd page loads. Be polite - it is scraping.
REQUEST_DELAY_SECONDS=1.0

# Where the "already synced" database lives. Keep this on a persistent volume.
CACHE_PATH=/config/letterboxd-sync.db

TZ=Europe/Amsterdam
LOG_LEVEL=INFO
