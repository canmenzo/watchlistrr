# ---------------------------------------------------------------------------
# Letterboxd source
# ---------------------------------------------------------------------------
# Your Letterboxd username. Your watchlist must be publicly visible.
LETTERBOXD_USERNAME=yourusername

# Optional: more people and more lists, comma separated. A bare username means
# that user's watchlist. Also accepts "user/list/slug" and full URLs. Films on
# several lists are only requested once.
#LETTERBOXD_LISTS=yourusername,housemate,partner
#LETTERBOXD_LISTS=yourusername/list/best-of-2024,https://letterboxd.com/friend/watchlist/

# ---------------------------------------------------------------------------
# Seerr (formerly Overseerr)
# ---------------------------------------------------------------------------
# Settings > General > API Key. That key's user needs Request permission.
OVERSEERR_URL=http://192.168.1.10:5055
OVERSEERR_API_KEY=changeme
# Optional: file the requests under a specific Seerr user id instead of the
# API key's owner (Settings > Users shows the id in each user's URL).
#OVERSEERR_USER_ID=1
#OVERSEERR_IS_4K=false

# ---------------------------------------------------------------------------
# Scheduling and behaviour
# ---------------------------------------------------------------------------
# Minutes between syncs. 0 = run once and exit (use this with cron).
# A routine sync is a single request, so 15 is comfortable.
SYNC_INTERVAL_MINUTES=15

# Report what would happen without changing anything.
DRY_RUN=false

# Only process the first N films. 0 = no limit. Handy for a first test.
LIMIT=0

# Seconds to wait between Letterboxd page loads. Be polite - it is scraping.
REQUEST_DELAY_SECONDS=1.0

# Where the "already synced" database lives. Keep this on a persistent volume.
CACHE_PATH=/config/watchlistrr.db

TZ=UTC
LOG_LEVEL=INFO
